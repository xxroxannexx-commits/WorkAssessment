    {
      "parameters": {
        "jsCode": "const message = $input.first().json.message;\n\n// Telegram sends multiple resolutions of the same photo; the last one is the largest/highest quality\nconst largestPhoto = message.photo[message.photo.length - 1];\n\n// \"Submission date\" = the date the photo was sent to the bot, in the bot server's UTC time\nconst submissionDate = new Date(message.date * 1000);\nconst dateFolder = submissionDate.toISOString().split('T')[0]; // YYYY-MM-DD\n\nreturn [{\n  json: {\n    file_id: largestPhoto.file_id,\n    chat_id: message.chat.id,\n    submission_date: dateFolder,\n    submission_timestamp: submissionDate.toISOString()\n  }\n}];"
      },
      "id": "e6f166a6-ae5e-4bc7-bb88-80e5daa95df8",
      "name": "Extract Photo Info",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -928,
        96
      ]
    },
    {
      "parameters": {
        "resource": "file",
        "fileId": "={{ $json.file_id }}",
        "additionalFields": {}
      },
      "id": "3697de0f-66b5-4a09-a19b-218db86036fb",
      "name": "Download Photo",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        -704,
        96
      ],
      "webhookId": "b806a998-2a0b-43ce-a963-d4c8b644c14c",
      "credentials": {
        "telegramApi": {
          "id": "YOUR_CREDENTIAL_ID",
          "name": "Telegram account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first();\nconst binaryData = item.binary.data;\nconst buffer = await this.helpers.getBinaryDataBuffer(0, 'data');\nconst base64 = buffer.toString('base64');\nconst mimeType = binaryData.mimeType || 'image/jpeg';\n\nreturn [{\n  json: {\n    ...item.json,\n    base64Image: base64,\n    mimeType: mimeType\n  },\n  binary: item.binary\n}];"
      },
      "id": "b4dcb6e7-f4b9-445d-93ec-067e5e440690",
      "name": "Convert to Base64",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -480,
        96
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-3.6-flash:generateContent",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpQueryAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ contents: [ { parts: [ { text: \"Extract the following fields from this receipt image and respond with ONLY valid JSON (no markdown, no code fences, no explanation): merchant_name (string), date (the date printed on the receipt, formatted YYYY-MM-DD, or null if not visible), total_amount (number only, no currency symbol), currency (3-letter code like USD or PHP, guess from context if not printed). If a field cannot be determined, use null.\" }, { inline_data: { mime_type: $json.mimeType, data: $json.base64Image } } ] } ], generationConfig: { temperature: 0.1 } }) }}",
        "options": {}
      },
      "id": "3d937e8d-cc98-470f-b7fe-b506b3506909",
      "name": "Gemini Extract Receipt",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -256,
        96
      ],
      "retryOnFail": true,
      "waitBetweenTries": 2000,
      "credentials": {
        "httpQueryAuth": {
          "id": "YOUR_CREDENTIAL_ID",
          "name": "Query Auth account"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst text = response.candidates[0].content.parts[0].text;\nconst cleaned = text.replace(/```json\\n?/g, '').replace(/```\\n?/g, '').trim();\n\nlet parsed;\ntry {\n  parsed = JSON.parse(cleaned);\n} catch (e) {\n  parsed = { merchant_name: null, date: null, total_amount: null, currency: null, category: null, parse_error: text };\n}\n\nconst prev = $('Extract Photo Info').first().json;\n\nreturn [{\n  json: {\n    ...prev,\n    merchant_name: parsed.merchant_name,\n    receipt_date: parsed.date,\n    total_amount: parsed.total_amount,\n    currency: parsed.currency,\n    parse_error: parsed.parse_error || null\n  },\n  binary: $('Download Photo').first().binary\n}];"
      },
