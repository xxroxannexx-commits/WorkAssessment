    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst prev = $('Parse Gemini Response').first().json;\nconst foundId = items.length > 0 ? items[0].json.id : null;\n\nreturn [{\n  json: {\n    ...prev,\n    folderFound: !!foundId,\n    existingFolderId: foundId\n  },\n  binary: $('Parse Gemini Response').first().binary\n}];"
      },
