      "name": "Get Labels",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [
        224,
        -112
      ],
      "executeOnce": true,
      "webhookId": "0959033b-4692-4f2b-88ad-ffce807dec92",
