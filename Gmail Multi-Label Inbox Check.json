    {
      "parameters": {
        "jsCode": "const src = $('Extract Sender Info').all();\nconst byId = {};\nfor (const s of src) { byId[String(s.json.messageId)] = s; }\nconst out = [];\nfor (const item of $input.all()) {\n  const mid = String(item.json.messageId);\n  const senderFolderId = item.json.senderFolderId;\n  const s = byId[mid];\n  if (!s) continue;\n  const bin = s.binary || {};\n  for (const key of Object.keys(bin)) {\n    const b = bin[key];\n    out.push({\n      json: {\n        messageId: mid,\n        senderFolderId: senderFolderId,\n        filename: b.fileName || key,\n        senderName: s.json.senderName,\n        label: s.json.primaryLabel,\n      },\n      binary: { data: b },\n    });\n  }\n}\nreturn out;"
      },
