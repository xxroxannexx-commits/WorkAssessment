    {
      "parameters": {
        "jsCode": "const emails = $('Check Gmail Inbox').all();\nconst labelItems = $('Get Labels').all();\nconst idToName = {};\nfor (const li of labelItems) { if (li.json && li.json.id) idToName[li.json.id] = li.json.name; }\nfunction firstDefined(){ for (const x of arguments){ if (x!==undefined && x!==null && x!=='') return x; } return ''; }\nconst wanted = ['Report', 'Invoice', 'Job Application'];\nconst sys = ['unread','inbox','sent','draft','spam','trash','important','starred','category_updates','category_personal','category_promotions','category_social','category_forums'];\nconst out = [];\nfor (const e of emails) {\n  const j = e.json || {};\n  let fromRaw = firstDefined(j.From, j.from, j.headers && j.headers.from, '');\n  if (fromRaw && typeof fromRaw === 'object') {\n    if (Array.isArray(fromRaw.value) && fromRaw.value.length) {\n      const v = fromRaw.value[0];\n      fromRaw = (v.name ? v.name + ' ' : '') + '<' + (v.address || '') + '>';\n    } else { fromRaw = fromRaw.text || ''; }\n  }\n  fromRaw = String(fromRaw || '');\n  let senderName = fromRaw; let senderEmail = '';\n  const m = fromRaw.match(/^\\s*\"?([^\"<]*)\"?\\s*<([^>]+)>/);\n  if (m) { senderName = (m[1] || '').trim(); senderEmail = (m[2] || '').trim(); }\n  else { const em = fromRaw.match(/[^\\s<>]+@[^\\s<>]+/); if (em) senderEmail = em[0]; }\n  if (!senderName) senderName = senderEmail ? senderEmail.split('@')[0] : 'Unknown Sender';\n  senderName = senderName.replace(/[\\\\/:*?\"<>|]/g, '').replace(/\\s+/g, ' ').trim() || 'Unknown Sender';\n  const subject = firstDefined(j.Subject, j.subject, j.headers && j.headers.subject, '(no subject)');\n  let ms = j.internalDate ? Number(j.internalDate) : NaN;\n  let d;\n  if (!isNaN(ms) && ms > 0) { d = new Date(ms); }\n  else { const ds = firstDefined(j.date, j.headers && j.headers.date, ''); d = ds ? new Date(ds) : new Date(); }\n  if (isNaN(d.getTime())) d = new Date();\n  const pad = (n) => String(n).padStart(2, '0');\n  const dateReceived = d.getFullYear() + '-' + pad(d.getMonth()+1) + '-' + pad(d.getDate());\n  const rawLabels = Array.isArray(j.labelIds) ? j.labelIds : (Array.isArray(j.labels) ? j.labels : []);\n  const names = rawLabels.map((l) => idToName[l] || String(l));\n  let primaryLabel = '';\n  for (const w of wanted) { if (names.some((n) => n.toLowerCase() === w.toLowerCase())) { primaryLabel = w; break; } }\n  if (!primaryLabel) {\n    const custom = names.find((n) => !sys.includes(n.toLowerCase()) && !/^label_/i.test(n));\n    primaryLabel = custom || 'Unlabeled';\n  }\n  primaryLabel = String(primaryLabel).replace(/[\\\\/:*?\"<>|]/g, '').trim() || 'Unlabeled';\n  const bin = e.binary || {};\n  const attachmentCount = Object.keys(bin).length;\n  const folderLabelDate = primaryLabel + ' - ' + dateReceived;\n  out.push({\n    json: {\n      messageId: firstDefined(j.id, j.messageId, ''),\n      senderName: senderName,\n      senderEmail: senderEmail,\n      subject: subject,\n      dateReceived: dateReceived,\n      primaryLabel: primaryLabel,\n      folderLabelDate: folderLabelDate,\n      attachmentCount: attachmentCount,\n    },\n    binary: e.binary,\n  });\n}\nreturn out;"
      },
